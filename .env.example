# Copy this file to .env.local (local) and add the same names in Vercel > Project > Settings > Environment Variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Add your database name, e.g. .../baharnarenj?retryWrites=true
MONGODB_URI=

# Signs the owner login cookie. At least 32 random characters, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_SESSION_SECRET=

# Optional but recommended on a real server: the starting password of the two owners (instead of 1234).
OWNER_SEED_PASSWORD=

# Optional: Web Push (notification on the owner's phone even when the site is closed). Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Local testing only (ignored in production): marks every online booking as paid so you can see the owner notification without a payment gateway.
# PAYMENT_FAKE=1

# ---- Local development on your own computer (Windows): install MongoDB Community Server, then use this line (it is also the default in development):
# MONGODB_URI=mongodb://127.0.0.1:27017/baharnarenj
# ---- MongoDB Atlas looks like:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/baharnarenj?retryWrites=true&w=majority
