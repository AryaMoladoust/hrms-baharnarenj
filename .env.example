# Copy this file to .env.local for local development. On the VPS, add these variables to the environment used by your Node.js/PM2 process.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Add your database name, e.g. .../baharnarenj?retryWrites=true
MONGODB_URI=

# Signs the owner login cookie. At least 32 random characters, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_SESSION_SECRET=

# Optional but recommended on a real server: the starting password of the two owners (instead of 1234).
OWNER_SEED_PASSWORD=

# Optional: Web Push (notification on the owner's phone even when the site is closed). Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ZarinPal payment gateway (required for real online payments)
# Merchant ID from the ZarinPal panel. Keep this secret on the server; never expose it as NEXT_PUBLIC_*
ZARINPAL_MERCHANT_ID=
# Set to 1 only when using a Sandbox merchant account. Use 0 for the live merchant account.
ZARINPAL_SANDBOX=0
# Public HTTPS origin, without a trailing slash. Must be reachable from the internet; localhost is not accepted by ZarinPal.
# For full local testing, use a temporary HTTPS tunnel to your local Next.js port. The callback goes to this URL.
NEXT_PUBLIC_SITE_URL=https://baharnarenjrasht.ir

# Local testing only (ignored in production): marks every online booking as paid without contacting ZarinPal.
# PAYMENT_FAKE=1

# ---- Local development on your own computer (Windows): install MongoDB Community Server, then use this line (it is also the default in development):
# MONGODB_URI=mongodb://127.0.0.1:27017/baharnarenj
# ---- MongoDB Atlas looks like:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/baharnarenj?retryWrites=true&w=majority

# ---- SEO ----
# The final public address of the site (no slash at the end). Set it the day you connect a real domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.ir
# Verification codes from Google Search Console / Bing Webmaster Tools (the "HTML tag" method), if you use that method:
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
